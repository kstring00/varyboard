{
  "name": "varyboard-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "assets:fetch": "node scripts/fetch-assets.mjs",
    "assets:optimize": "node scripts/optimize-images.mjs",
    "assets:cutout": "python3 scripts/cutout.py",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check:intake": "tsx scripts/check-intake.ts",
    "audit:content": "tsx scripts/audit-content.ts",
    "audit:safety": "node scripts/audit-safety.mjs",
    "prebuild": "npm run check:placeholders && npm run audit:safety && npm run check:intake && npm run audit:content",
    "vercel-build": "next build",
    "assets:og": "node scripts/make-og.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.5",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "22.x"
  }
}
