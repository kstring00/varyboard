# Copy to .env.local for local development. On Vercel, set these under
# Project > Settings > Environment Variables.

# REQUIRED in production. Hostname that serves the Shopify cart, no protocol.
# Once thevaryboard.com points at Vercel this must NOT be thevaryboard.com.
# Use the store's *.myshopify.com domain or a subdomain connected to Shopify.
NEXT_PUBLIC_SHOP_DOMAIN=your-store.myshopify.com

# Optional. Canonical site URL for metadata, sitemap and robots.
# Defaults to the Vercel production URL when unset.
NEXT_PUBLIC_SITE_URL=https://thevaryboard.com
