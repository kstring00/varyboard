# Copy to .env.local for local development. On Vercel, set these under
# Project > Settings > Environment Variables.

# Hostname that serves the Shopify cart, no protocol. Defaults to thevaryboard.com,
# which is correct only while that domain still points at Shopify. REQUIRED once
# thevaryboard.com is assigned to the Vercel project: use the store's *.myshopify.com
# domain or a subdomain connected to Shopify. The production build fails if the
# checkout host is the site's own domain.
NEXT_PUBLIC_SHOP_DOMAIN=your-store.myshopify.com

# Optional. Canonical site URL for metadata, sitemap and robots.
# Defaults to the Vercel production URL when unset.
NEXT_PUBLIC_SITE_URL=https://thevaryboard.com

# Launch switch. Leave unset until launch day, then set to true for Production only:
# lifts the noindex on production. Previews stay noindex.
SITE_LAUNCHED=
